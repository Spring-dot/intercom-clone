// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  admin
  agent
}

enum ConversationChannel {
  chat
  email
}

enum ConversationStatus {
  open
  snoozed
  resolved
}

enum MessageSenderType {
  contact
  agent
  ai
  system
}

enum ArticleStatus {
  draft
  published
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  // Used for the inbound-email address pattern support+{slug}@EMAIL_DOMAIN
  // (see src/lib/email.ts) -- how the inbound webhook resolves which
  // workspace an email belongs to.
  slug      String   @unique
  // Vanity domain for the public help center (e.g. help.theircompany.com).
  // Setting this only records intent + lets us DNS-verify it -- it does NOT
  // by itself make the domain serve traffic. See the big comment at the top
  // of src/app/api/domain/route.ts for what else that actually requires.
  customDomain         String?  @unique
  customDomainVerified Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       WorkspaceMember[]
  invitations   Invitation[]
  contacts      Contact[]
  conversations Conversation[]
  categories    Category[]
  articles      Article[]
}

// Clerk user, mirrored locally by id = Clerk userId
model User {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       WorkspaceMember[]
  assignedTo        Conversation[]    @relation("ConversationAssignee")
  authoredMessages   Message[]
  sentInvitations   Invitation[]      @relation("InvitationInviter")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(agent)
  // Heartbeated by the dashboard shell every AGENT_HEARTBEAT_MS (see
  // src/lib/presence.ts). Read to decide whether the widget shows "We're
  // online" -- absence of a recent beat is what "offline" means, so no
  // explicit disconnect event is needed (a closed laptop just stops beating).
  lastSeenAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

// A pending invite for someone who may not have a Clerk account yet, which is
// why this keys off `email` rather than a userId. Redeemed in
// ensureWorkspace(): on first sign-in we look for a pending invitation
// matching the new user's verified Clerk email and join them to that
// workspace instead of creating a fresh one for them.
model Invitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(agent)
  // Random, unguessable; the /invite/{token} link an admin shares. Redeeming
  // still requires the signed-in user's email to match `email`, so a leaked
  // token alone can't get a stranger into the workspace.
  token       String        @unique
  invitedById String?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  // One live invite per email per workspace; re-inviting updates the existing
  // row (new token, new expiry) rather than piling up duplicates.
  @@unique([workspaceId, email])
  @@index([email])
}

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  avatarUrl   String?
  // Opaque id for anonymous widget visitors (the localStorage "visitorToken").
  // Null for contacts created from the dashboard side.
  externalId  String?
  // Heartbeated by the widget while its panel is open; the inbox uses it to
  // show whether the visitor is still on the page (same "recent beat = online"
  // rule as WorkspaceMember.lastSeenAt).
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([workspaceId, externalId])
  @@unique([workspaceId, email])
  @@index([workspaceId])
}

model Conversation {
  id          String              @id @default(cuid())
  workspaceId String
  contactId   String
  assigneeId  String?
  channel     ConversationChannel
  status      ConversationStatus  @default(open)
  snoozedUntil DateTime?
  // The original inbound subject line, for email channel conversations only
  // -- replies reuse it as "Re: {emailSubject}".
  emailSubject String?
  // JSON-encoded { whatUserWants, whatsBeenTried, currentStatus }, produced by
  // summarizeConversation() in src/lib/ai.ts. Regenerated only when new
  // messages exist since aiSummaryUpdatedAt (see that file for the cache rule).
  aiSummary          String?
  aiSummaryUpdatedAt DateTime?
  // Read receipts. Stored per side as a watermark timestamp rather than a
  // per-message flag: "everything created at or before this instant has been
  // seen by that side". One row to update on read instead of N, and a message
  // arriving later is automatically unread without any backfill.
  agentLastReadAt   DateTime?
  contactLastReadAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee  User?     @relation("ConversationAssignee", fields: [assigneeId], references: [id])
  messages  Message[]

  @@index([workspaceId])
  @@index([contactId])
  // Serves the inbox's status filter and, together with snoozedUntil, the
  // reopen sweep in /api/cron/reopen-snoozed.
  @@index([workspaceId, status])
  @@index([status, snoozedUntil])
}

model Message {
  id             String            @id @default(cuid())
  workspaceId    String
  conversationId String
  senderType     MessageSenderType
  authorId       String?
  body           String
  // RFC 5322 Message-ID of this specific message, when it travels over
  // email -- either one we minted for an outbound reply, or the sending
  // mail server's own id for an inbound message. Not unique (a redelivered
  // inbound webhook could try to insert the same id twice; deduped in the
  // webhook handler rather than at the DB constraint level).
  emailMessageId String?
  // The In-Reply-To header value this message carried, if any.
  emailInReplyTo String?
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])

  @@index([workspaceId])
  @@index([conversationId])
  @@index([emailMessageId])
}

model Category {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  Article[]

  @@unique([workspaceId, slug])
}

model Article {
  id          String        @id @default(cuid())
  workspaceId String
  categoryId  String
  title       String
  slug        String
  content     String
  status      ArticleStatus @default(draft)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([categoryId])
}
